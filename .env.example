# Local-only Serafina runtime. Do not configure cloud endpoints here.
PORT=3000
SERAFINA_HOST=127.0.0.1

# Mutable data stays outside this repository and outside synced folders.
# macOS default: ~/Library/Application Support/Project Serafina
# SERAFINA_DATA_DIR=/absolute/local/path/Project Serafina

# Provision these paths on the destination machine before `npm run local:start`.
SERAFINA_PYTHON=/absolute/path/to/serafina/.venv/bin/python
SERAFINA_DOCLING_ARTIFACTS_PATH=/absolute/local/path/Project Serafina/models/docling
SERAFINA_OLLAMA_BASE_URL=http://127.0.0.1:11434
SERAFINA_OLLAMA_MODEL=qwen2.5:7b

# CoStar property fields are in the leading summary pages. Keep the expensive
# Docling pipeline bounded; valid values are 4-10.
SERAFINA_MAX_PDF_PAGES=10
