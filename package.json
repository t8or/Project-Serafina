{
  "name": "tailadmin-free",
  "version": "2.0.1",
  "description": "TailAdmin is a high-quality, open-source, and free Tailwind CSS admin template that is perfect for creating data-rich backends, powerful web applications and dashboard-admin projects.",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "NODE_ENV=development webpack serve --open --config webpack.config.js",
    "build": "NODE_ENV=production webpack --config webpack.config.js",
    "local:setup": "node scripts/local-setup.js",
    "local:doctor": "node scripts/local-doctor.js",
    "local:start": "npm run build && node server.js",
    "start": "npm run local:start",
    "test": "node scripts/test.js",
    "sort": "npx prettier --write src",
    "test:js": "node --test"
  },
  "keywords": [],
  "author": {
    "name": "TailAdmin",
    "email": "hello@tailadmin.com",
    "url": "https://tailadmin.com"
  },
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.24.9",
    "@babel/preset-env": "^7.24.8",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/postcss": "^4.0.0",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^9.1.3",
    "css-loader": "^7.1.2",
    "file-loader": "^6.2.0",
    "glob": "^11.0.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.9.0",
    "postcss": "^8.4.39",
    "postcss-loader": "^8.1.1",
    "postcss-preset-env": "^9.6.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "@alpinejs/persist": "^3.14.1",
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/list": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "alpinejs": "^3.14.1",
    "apexcharts": "^3.51.0",
    "chart.js": "^4.4.6",
    "dotenv": "^17.2.3",
    "dropzone": "^6.0.0-beta.2",
    "express": "^5.2.1",
    "flatpickr": "^4.6.13",
    "fullcalendar": "^6.1.15",
    "jsvectormap": "^1.6.0",
    "multer": "^2.0.2"
  }
}
